{
  "name": "@middy-appsync/constructs",
  "version": "0.1.4",
  "description": "CDK constructs for middy-appsync",
  "sideEffects": false,
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://www.sls.dev",
  "author": {
    "name": "sls.dev",
    "email": "dev@sls.dev",
    "url": "https://www.sls.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slsdotdev/middy-appsync.git",
    "directory": "packages/constructs"
  },
  "bugs": {
    "url": "https://github.com/slsdotdev/middy-appsync/issues"
  },
  "keywords": [
    "Middy.js",
    "AppSync",
    "AWS",
    "CDK",
    "TypeScript"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "comment-parser": "^1.4.6",
    "tinyglobby": "^0.2.16"
  },
  "peerDependencies": {
    "@middy-appsync/graphql": ">=0.1.4",
    "esbuild": ">=0.27"
  },
  "devDependencies": {
    "@aws-appsync/utils": "^2.1.1",
    "aws-cdk-lib": "^2.253.1",
    "constructs": "^10.6.0"
  }
}
